      <ul>
        <li><a href="/categorias/">Categorias</a></li>
        <li><a href="/tags/">Tags</a></li>
        <li><a href="/arquivo/">Arquivo</a></li>
        <li><a href="/busca/">Busca</a></li>
        <li><a href="/feed.xml">Feed RSS</a></li>
        <li><a href="/en/curriculum/">Curriculum (EN)</a></li>
      </ul>
    </div>
  </div>
  <div class="container rodape-base">
    <span>© {{ "" | anoAtual }} Renato Barros. Todos os direitos reservados.</span>
    <a href="#conteudo" class="voltar-topo">Voltar ao topo ↑</a>
  </div>
</footer>
