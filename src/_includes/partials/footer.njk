      <a class="marca" href="/">
        <span class="marca-logo" aria-hidden="true"><b>R</b><i>B</i></span>
        <span class="marca-texto"><strong>Renato Barros</strong><small>{{ site.autor.cargo }}</small></span>
      </a>
      <p class="rodape-bio">{{ site.subtitulo }}.</p>
      {% include "partials/sociais.njk" %}
