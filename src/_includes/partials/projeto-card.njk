<a class="projeto-card" href="{{ p.url }}" data-cat="{{ p.categoria | slug }}">
  <div class="projeto-topo">
    <span class="projeto-rotulo">{{ p.rotulo }}</span>
    <span class="projeto-tipo">{{ p.tipo }}</span>
  </div>
  <h3>{{ p.titulo }}</h3>
  <p>{{ p.descricao }}</p>
  <span class="link-seta">Abrir projeto →</span>
</a>
