<header class="topo">
  <div class="container topo-inner">
    <a class="marca" href="/" aria-label="{{ site.titulo }} — início">
      <span class="marca-logo" aria-hidden="true"><b>R</b><i>B</i></span>
      <span class="marca-texto"><strong>Renato Barros</strong><small>Oracle · Exadata · Cloud · DBRE</small></span>
    </a>
    <nav class="menu" id="menu" aria-label="Menu principal">
      {%- for item in site.menu %}
      {%- set ativo = (page.url == item.url) or (item.url != "/" and page.url.startsWith(item.url)) or (item.url == "/curriculo/" and page.url.startsWith("/en/")) %}
      <a href="{{ item.url }}"{% if ativo %} aria-current="page"{% endif %}>{{ item.texto }}</a>
      {%- endfor %}
    </nav>
    <div class="topo-acoes">
      <button class="icone-btn" type="button" data-abrir-busca aria-label="Pesquisar (Ctrl+K)" title="Pesquisar (Ctrl+K)">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      </button>
      <button class="icone-btn" type="button" id="alternarTema" aria-label="Alternar tema claro/escuro" title="Alternar tema">
        <svg class="ico-lua" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"/></svg>
        <svg class="ico-sol" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      </button>
      <button class="icone-btn menu-btn" type="button" id="abrirMenu" aria-label="Abrir menu" aria-expanded="false" aria-controls="menu">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>
    </div>
  </div>
</header>
